<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>canvas-read</title>

  <%# StreamWeaver component styles (CSS vars, typography, sw-* classes) %>
  <style>
    <%= @sw_styles %>
  </style>

  <%# Override body to flex layout for the two-pane shell %>
  <style>
    html, body { height: 100%; overflow: hidden; margin: 0; padding: 0; display: flex; }
    body { font-family: system-ui, sans-serif; background: #f3f4f6; }

    /* Sidebar */
    #sidebar { width: 220px; flex-shrink: 0; border-right: 1px solid #d1d5db; overflow-y: auto;
               display: flex; flex-direction: column; background: #f9fafb; }
    #sidebar h2 { padding: 0.75rem 1rem; font-size: 0.7rem; text-transform: uppercase;
                  letter-spacing: .08em; color: #6b7280; border-bottom: 1px solid #e5e7eb; }
    .dir-header { padding: 0.4rem 1rem; font-size: 0.75rem; color: #4b5563; cursor: pointer;
                  user-select: none; display: flex; align-items: center; gap: 0.4rem; }
    .dir-header:hover { background: #e5e7eb; }
    .dir-arrow { font-size: 0.6rem; transition: transform 0.15s; }
    .dir-files { list-style: none; }
    .dir-files.collapsed { display: none; }
    .dir-files li a { display: block; padding: 0.35rem 1rem 0.35rem 1.75rem; font-size: 0.8rem;
                      color: #4b5563; text-decoration: none; white-space: nowrap;
                      overflow: hidden; text-overflow: ellipsis; }
    .dir-files li a:hover { background: #e5e7eb; color: #111827; }
    .dir-files li a.active { background: #dbeafe; color: #1d4ed8; font-weight: 600; }

    /* History section (collapsed by default) */
    .history-section-header { padding: 0.75rem 1rem; font-size: 0.7rem; text-transform: uppercase;
                              letter-spacing: .08em; color: #6b7280; border-top: 1px solid #e5e7eb;
                              cursor: pointer; user-select: none; display: flex; align-items: center;
                              gap: 0.4rem; margin: 0; }
    .history-section-header:hover { background: #e5e7eb; color: #374151; }
    .history-arrow { font-size: 0.6rem; transition: transform 0.15s; display: inline-block; }
    .history-section-header.expanded .history-arrow { transform: rotate(90deg); }
    .history-content.collapsed { display: none; }
    .history-session .dir-header { font-size: 0.7rem; color: #6b7280; padding-left: 1.25rem; }
    .history-session .dir-files li a { padding-left: 2.25rem; font-family: ui-monospace, monospace;
                                       font-size: 0.72rem; }

    /* Main pane */
    #main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    #content { flex: 1; overflow-y: auto; padding: 0; background: var(--sw-color-bg, #f8f8f8); }
    #content > * { max-width: none; }

    /* Nav bar */
    #nav { border-top: 1px solid #e5e7eb; padding: 0.5rem 1rem; display: flex;
           align-items: center; justify-content: space-between; flex-shrink: 0;
           background: #f9fafb; }
    #nav button { background: #e5e7eb; color: #374151; border: none; padding: 0.3rem 0.8rem;
                  border-radius: 4px; cursor: pointer; font-size: 0.8rem; }
    #nav button:hover { background: #d1d5db; }
    #nav button:disabled { opacity: 0.35; cursor: default; }
    #nav .counter { font-size: 0.8rem; color: #6b7280; }
  </style>

  <%# CDN dependencies for StreamWeaver components %>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/github.min.css">
  <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/highlight.min.js"></script>

  <%# Mermaid zoom/pan engine — inlined so swMermaidInit() is available before Alpine fires %>
  <script><%= @mermaid_zoom_js %></script>
  <%# Kick off mermaid CDN preload immediately (same pattern as bridge server) %>
  <script>if (window.swMermaidPreload) window.swMermaidPreload();</script>
</head>
<body class="sw-theme-default sw-layout-fluid">

<%
  docs_groups    = @file_list.docs_groups
  history_groups = @file_list.history_groups
  is_history     = @current_file && @file_list.history_dir?(File.dirname(@current_file))
  default_name   = if is_history
                     session   = File.basename(File.dirname(@current_file))
                     timestamp = File.basename(@current_file, '.rb')
                     "#{session}-#{timestamp}"
                   end
%>
<nav id="sidebar">
  <% # docs_groups / history_groups computed above %>

  <h2><%= history_groups.any? ? 'Docs' : 'Files' %></h2>
  <% docs_groups.each do |dir, entries| %>
    <% dir_label = File.basename(dir) %>
    <div class="dir-section">
      <div class="dir-header" onclick="toggleDir(this)">
        <span class="dir-arrow">▼</span>
        <span title="<%= dir %>"><%= dir_label %></span>
      </div>
      <ul class="dir-files">
        <% entries.each do |filepath, idx| %>
          <li>
            <a href="/?file=<%= idx %>"
               class="<%= idx == @current_index ? 'active' : '' %>"
               title="<%= filepath %>">
              <%= File.basename(filepath, '.rb') %>
            </a>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if history_groups.any? %>
    <h2 class="history-section-header" onclick="toggleHistory(this)">
      <span class="history-arrow">▶</span>
      History (<%= history_groups.size %>)
    </h2>
    <div class="history-content collapsed">
      <% history_groups.each do |dir, entries| %>
        <% session_label = File.basename(dir) %>
        <div class="dir-section history-session">
          <div class="dir-header" onclick="toggleDir(this)">
            <span class="dir-arrow">▶</span>
            <span title="<%= dir %>"><%= session_label %></span>
          </div>
          <ul class="dir-files collapsed">
            <% entries.each do |filepath, idx| %>
              <li>
                <a href="/?file=<%= idx %>"
                   class="<%= idx == @current_index ? 'active' : '' %>"
                   title="<%= filepath %>">
                  <%= File.basename(filepath, '.rb') %>
                </a>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>
</nav>

<div id="main">
  <div id="content">
    <%= @content_html %>
  </div>
  <div id="nav">
    <% prev_idx = @current_index - 1 %>
    <% next_idx = @current_index + 1 %>
    <button onclick="location.href='/?file=<%= prev_idx %>'"
            <%= prev_idx < 0 ? 'disabled' : '' %>>◀ Prev</button>
    <span class="counter"><%= @current_index + 1 %> of <%= @file_list.size %></span>
    <button onclick="location.href='/?file=<%= next_idx %>'"
            <%= next_idx >= @file_list.size ? 'disabled' : '' %>>Next ▶</button>
  </div>
</div>

<script>
  function toggleDir(header) {
    const ul = header.nextElementSibling;
    const arrow = header.querySelector('.dir-arrow');
    ul.classList.toggle('collapsed');
    arrow.style.transform = ul.classList.contains('collapsed') ? 'rotate(-90deg)' : '';
  }

  function toggleHistory(header) {
    const content = header.nextElementSibling;
    content.classList.toggle('collapsed');
    header.classList.toggle('expanded');
  }

  document.addEventListener('keydown', (e) => {
    const cur = <%= @current_index %>;
    const max = <%= @file_list.size - 1 %>;
    if (e.key === 'ArrowLeft' && cur > 0)   location.href = '/?file=' + (cur - 1);
    if (e.key === 'ArrowRight' && cur < max) location.href = '/?file=' + (cur + 1);
  });
</script>

<% if is_history %>
  <%# Save-as-doc widget — promotes this history snapshot to docs/streamweaver_canvas/.
      Mirrors bridge_server.rb's save_doc_widget look-and-feel (sw-save-doc-* CSS,
      Alpine modal). Only injected when the current file is a history entry. %>
  <style>
    [x-cloak] { display: none !important; }
    .sw-save-doc-btn {
      position: fixed; bottom: 1rem; right: 1rem; z-index: 50;
      background: var(--sw-color-primary, #1f6feb); color: #fff;
      border: none; border-radius: 999px; padding: 0.55rem 1rem;
      font-size: 0.85rem; font-weight: 600; cursor: pointer;
      box-shadow: 0 6px 16px rgba(28,25,23,0.18);
      opacity: 0.85; transition: opacity 120ms ease, transform 120ms ease;
    }
    .sw-save-doc-btn:hover { opacity: 1; transform: translateY(-1px); }
    .sw-save-doc-modal {
      position: fixed; inset: 0; z-index: 60;
      background: rgba(15, 17, 23, 0.45);
      display: flex; align-items: center; justify-content: center;
    }
    .sw-save-doc-dialog {
      background: #fff; border-radius: 8px; padding: 1.5rem;
      width: min(440px, 90vw); box-shadow: 0 20px 50px rgba(0,0,0,0.25);
      font-family: 'Source Sans 3', system-ui, sans-serif;
    }
    .sw-save-doc-dialog h3 { margin: 0 0 0.5rem 0; font-size: 1.1rem; }
    .sw-save-doc-dialog p.hint {
      margin: 0 0 1rem 0; color: #6b7280; font-size: 0.85rem;
    }
    .sw-save-doc-dialog input[type=text] {
      width: 100%; padding: 0.55rem 0.75rem;
      border: 1px solid #d1d5db; border-radius: 5px;
      font-size: 0.95rem; font-family: ui-monospace, monospace;
      box-sizing: border-box;
    }
    .sw-save-doc-dialog input[type=text]:focus {
      outline: 2px solid var(--sw-color-primary, #1f6feb); outline-offset: -1px;
      border-color: transparent;
    }
    .sw-save-doc-error {
      margin-top: 0.75rem; padding: 0.5rem 0.75rem;
      background: #fee2e2; color: #991b1b; border-radius: 4px;
      font-size: 0.85rem;
    }
    .sw-save-doc-success {
      margin-top: 0.75rem; padding: 0.5rem 0.75rem;
      background: #dcfce7; color: #166534; border-radius: 4px;
      font-size: 0.85rem; word-break: break-all;
    }
    .sw-save-doc-actions {
      display: flex; justify-content: flex-end; gap: 0.5rem;
      margin-top: 1rem;
    }
    .sw-save-doc-actions button {
      padding: 0.45rem 1rem; border-radius: 5px;
      font-size: 0.9rem; cursor: pointer; border: 1px solid transparent;
    }
    .sw-save-doc-actions button:disabled { opacity: 0.5; cursor: not-allowed; }
    .sw-save-doc-cancel { background: #f3f4f6; color: #374151; border-color: #d1d5db; }
    .sw-save-doc-cancel:hover:not(:disabled) { background: #e5e7eb; }
    .sw-save-doc-save {
      background: var(--sw-color-primary, #1f6feb); color: #fff;
    }
    .sw-save-doc-save:hover:not(:disabled) { filter: brightness(1.05); }
  </style>
  <div x-data="{
    open: false,
    name: <%= default_name.to_json %>,
    file: <%= @current_index %>,
    saving: false,
    savedPath: null,
    error: null,
    openDialog() {
      this.error = null; this.savedPath = null;
      this.open = true;
      this.$nextTick(() => this.$refs.input && this.$refs.input.select());
    },
    async save() {
      if (this.saving) return;
      this.saving = true; this.error = null;
      try {
        const res = await fetch('/save-doc', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({file: this.file, name: this.name})
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          this.savedPath = data.path;
          setTimeout(() => { this.open = false; }, 1800);
        } else {
          this.error = data.error || ('HTTP ' + res.status);
        }
      } catch (e) {
        this.error = e.message;
      } finally {
        this.saving = false;
      }
    }
  }" @keydown.escape.window="open = false">
    <button class="sw-save-doc-btn" @click="openDialog()" title="Save this history snapshot as a persistent doc">
      💾 Save as doc
    </button>
    <div x-show="open" x-cloak class="sw-save-doc-modal" @click.self="open = false">
      <div class="sw-save-doc-dialog" @click.stop>
        <h3>Save snapshot as doc</h3>
        <p class="hint">Promotes this history entry to <code>docs/streamweaver_canvas/&lt;name&gt;.rb</code> (or <code>~/.streamweaver/canvas/</code> outside a git repo).</p>
        <input type="text" x-model="name" x-ref="input"
               @keydown.enter.prevent="save()"
               :disabled="saving"
               placeholder="my-canvas-doc">
        <div x-show="error" x-text="error" class="sw-save-doc-error"></div>
        <div x-show="savedPath" class="sw-save-doc-success">
          ✓ Saved to <code x-text="savedPath"></code>
        </div>
        <div class="sw-save-doc-actions">
          <button class="sw-save-doc-cancel" @click="open = false" :disabled="saving">Cancel</button>
          <button class="sw-save-doc-save" @click="save()" :disabled="saving">
            <span x-show="!saving">Save</span>
            <span x-show="saving">Saving...</span>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
</body>
</html>
