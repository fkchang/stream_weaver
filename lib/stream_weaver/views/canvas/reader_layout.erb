<%
  doc            = @doc
  # Browse (stream_weaver-rdh) can land here with no file open yet
  # (GET /browse before any file is clicked) -- doc.theme/layout have
  # nothing to fall back to in that case, so the body class falls back to
  # the reader's own defaults instead of reading through a nil doc.
  body_class     = if doc
                     "sw-theme-#{doc.theme} sw-layout-#{doc.layout} sw-reader"
                   else
                     "sw-theme-#{StreamWeaver::Canvas::Reader.fallback_theme} " \
                     "sw-layout-#{StreamWeaver::Canvas::Reader.fallback_layout} sw-reader"
                   end
  browse_mode    = !!@browse_mode
  # docs_groups/history_groups are meaningless in Browse mode (its sidebar
  # replaces them entirely) -- skipping them isn't just wasted work, it
  # avoids a NoMethodError the day canvas-read ships a "no configured
  # files, Browse only" boot mode, where @file_list would be nil.
  docs_groups    = browse_mode ? {} : @file_list.docs_groups(repo: @repo_filter)
  history_groups = browse_mode ? {} : @file_list.history_groups
  # Repo filter (stream_weaver-iugu). repo_labels lists every discovered docs
  # root; repo_qs carries the ACTIVE filter through every /?file=N link so it
  # survives navigation -- without it, one Prev/Next click silently snaps the
  # rail back to the host-repo default.
  repo_labels    = browse_mode ? [] : @file_list.repo_labels
  repo_qs        = @repo_param ? "&amp;repo=#{ERB::Util.url_encode(@repo_param)}" : ''
  is_history     = @current_file && !browse_mode && @file_list.history_dir?(File.dirname(@current_file))
  default_name   = if is_history
                     session   = File.basename(File.dirname(@current_file))
                     timestamp = File.basename(@current_file, '.rb')
                     "#{session}-#{timestamp}"
                   end
  # @breadcrumbs/@browse_parent/@repo_docs_root come from the route (Reader
  # #set_browse_ivars) -- the breadcrumb walk and repo_docs_root's
  # filesystem/.git lookup are controller work, not view formatting.
  browse_oob = StreamWeaver::Canvas::Reader::BROWSE_OOB
  # Which groups get a delete control (stream_weaver-uvaj): only the two
  # roots THIS process owns -- the repo it was launched in and the global
  # store. A peer repo surfaced by discovery is readable here and never
  # deletable, so its rows get no trash icon; that's the same boundary
  # POST /delete-doc enforces server-side, mirrored into the UI so you're
  # never offered a button that can only answer 403. Resolved once per
  # render rather than per row -- each answer costs a realpath plus the
  # .git walk behind repo_docs_root.
  deletable_dirs = browse_mode ? [] : docs_groups.keys.select { |d| StreamWeaver::Canvas::Reader.deletable_dir?(d) }
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>canvas-read</title>

  <%# Framework CSS, identical ordering to the canvas (PageShell is the single
      source of truth): layer pin, then CANVAS_CSS / master_theme_css /
      visual_skills_css all inside @layer stream-weaver. The reader's own
      chrome gets a later layer so it can't be outranked by, nor bleed into,
      framework rules. %>
  <%= StreamWeaver::PageShell.framework_css_html(extra_layers: %w[sw-reader-chrome]) %>

  <%# The doc's own use_stylesheet CSS -- unlayered, so it wins everything.
      Nothing to inline with no doc open yet (a bare Browse listing). %>
  <%= StreamWeaver::PageShell.user_css_html(inline_stylesheets: doc ? doc.inline_stylesheets : []) %>

  <%# Reader chrome. BOTH layered and #sw-reader-*-scoped, on purpose:
      scoping alone would let CANVAS_CSS/master_theme_css's bare h1..h6/p/a
      rules style the rail; layering alone would let an unscoped rule here
      (e.g. `body { font-family }`) beat theme rules for the whole page.
      The `html` padding rule below is the one deliberate exception -- it has
      no framework equivalent to lose to. spec/canvas/reader_chrome_css_spec.rb
      enforces this scoping; keep every new selector rooted at html or
      #sw-reader-. %>
  <style id="sw-reader-chrome-css">@layer sw-reader-chrome {
    /* Offset for the fixed rail lives on `html`, NOT body: this shrinks html's
       content box so body's own `margin: 0 auto` centering and the max-width
       the sidebar_toc CSS sets on body both keep working untouched, with zero
       cascade contact with views.rb's
       `body[class*="sw-layout-"] { margin: 0 auto; padding: ... }` shorthand. */
    html { padding-left: 220px; }
    html.sw-rail-collapsed { padding-left: 0; }

    /* Collapse is driven by `left`, never `transform`: a transformed ancestor
       becomes the containing block for its position:fixed descendants, which
       would trap the Save-as-doc modal (docked in #sw-reader-nav) inside the
       220px rail instead of covering the viewport. */
    #sw-reader-chrome {
      position: fixed; top: 0; bottom: 0; left: 0; width: 220px; z-index: 40;
      display: flex; flex-direction: column;
      background: #f9fafb; border-right: 1px solid #d1d5db;
      font-family: system-ui, sans-serif; font-size: 16px; line-height: 1.5;
      color: #4b5563;
      transition: left 160ms ease;
    }
    html.sw-rail-collapsed #sw-reader-chrome { left: -220px; }

    #sw-reader-toggle {
      position: absolute; top: 0.5rem; right: -2.25rem;
      width: 2rem; height: 2rem; padding: 0; line-height: 1;
      border: 1px solid #d1d5db; border-radius: 4px;
      background: #f9fafb; color: #4b5563;
      font-size: 0.95rem; cursor: pointer;
    }
    #sw-reader-toggle:hover { background: #e5e7eb; color: #111827; }

    /* Only the file list scrolls; #sw-reader-nav stays docked at the bottom. */
    #sw-reader-files { flex: 1; overflow-y: auto; min-height: 0; }
    #sw-reader-files h2 {
      margin: 0; padding: 0.75rem 1rem; font-size: 0.7rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: .08em; color: #6b7280;
      border-bottom: 1px solid #e5e7eb;
    }
    #sw-reader-files .dir-header {
      padding: 0.4rem 1rem; font-size: 0.75rem; color: #4b5563; cursor: pointer;
      user-select: none; display: flex; align-items: center; gap: 0.4rem;
    }
    #sw-reader-files .dir-header:hover { background: #e5e7eb; }
    /* Base glyph (▶) is the collapsed state; .expanded rotates it to point
       down. Same convention as .history-section-header.expanded below, so
       toggleSection() can drive both with one function. */
    #sw-reader-files .dir-arrow { font-size: 0.6rem; transition: transform 0.15s; display: inline-block; }
    #sw-reader-files .dir-header.expanded .dir-arrow { transform: rotate(90deg); }
    #sw-reader-files .dir-files { list-style: none; margin: 0; padding: 0; }
    #sw-reader-files .dir-files.collapsed { display: none; }
    #sw-reader-files .dir-files li a {
      display: block; padding: 0.35rem 1rem 0.35rem 1.75rem; font-size: 0.8rem;
      color: #4b5563; text-decoration: none; white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis;
    }
    #sw-reader-files .dir-files li a:hover { background: #e5e7eb; color: #111827; }
    #sw-reader-files .dir-files li a.active { background: #dbeafe; color: #1d4ed8; font-weight: 600; }
    /* Delete control (stream_weaver-uvaj). The row becomes a flex line so
       the trash sits at its right edge; the link keeps flex:1 + min-width:0
       so a long name still ellipsizes instead of shoving the button out of
       the 220px rail. Visible at rest, not hover-only: a control you have to
       discover by hovering is friction, and it's the confirm dialog -- not
       concealment -- that protects against a mis-click. */
    #sw-reader-files .dir-files li { display: flex; align-items: center; }
    #sw-reader-files .dir-files li a { flex: 1 1 auto; min-width: 0; }
    #sw-reader-files .sw-doc-delete {
      flex: 0 0 auto; border: none; background: none; cursor: pointer;
      padding: 0.35rem 0.65rem 0.35rem 0.15rem; font-size: 0.72rem;
      line-height: 1; opacity: 0.4;
    }
    #sw-reader-files .sw-doc-delete:hover { opacity: 1; }

    /* Confirm dialog. Same modal treatment as the Save-as-doc widget's
       (.sw-save-doc-*, further down), but rooted at #sw-reader-chrome so it
       stays inside this block's scoping guard (reader_chrome_css_spec)
       instead of needing a second unscoped <style> the way that widget did. */
    #sw-reader-chrome [x-cloak] { display: none !important; }
    #sw-reader-chrome .sw-doc-delete-modal {
      position: fixed; inset: 0; z-index: 60;
      background: rgba(15, 17, 23, 0.45);
      display: flex; align-items: center; justify-content: center;
    }
    #sw-reader-chrome .sw-doc-delete-dialog {
      background: #fff; border-radius: 8px; padding: 1.5rem;
      width: min(420px, 90vw); box-shadow: 0 20px 50px rgba(0,0,0,0.25);
      font-family: system-ui, sans-serif; color: #111827; text-align: left;
    }
    #sw-reader-chrome .sw-doc-delete-dialog h3 { margin: 0 0 0.5rem 0; font-size: 1.1rem; }
    #sw-reader-chrome .sw-doc-delete-dialog p.hint {
      margin: 0; color: #6b7280; font-size: 0.85rem; word-break: break-word;
    }
    #sw-reader-chrome .sw-doc-delete-error {
      margin-top: 0.75rem; padding: 0.5rem 0.75rem;
      background: #fee2e2; color: #991b1b; border-radius: 4px; font-size: 0.85rem;
    }
    #sw-reader-chrome .sw-doc-delete-actions {
      display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1rem;
    }
    #sw-reader-chrome .sw-doc-delete-actions button {
      padding: 0.45rem 1rem; border-radius: 5px; font-size: 0.9rem;
      cursor: pointer; border: 1px solid transparent;
    }
    #sw-reader-chrome .sw-doc-delete-actions button:disabled { opacity: 0.5; cursor: not-allowed; }
    #sw-reader-chrome .sw-doc-delete-cancel { background: #f3f4f6; color: #374151; border-color: #d1d5db; }
    #sw-reader-chrome .sw-doc-delete-cancel:hover:not(:disabled) { background: #e5e7eb; }
    #sw-reader-chrome .sw-doc-delete-confirm { background: #b91c1c; color: #fff; }
    #sw-reader-chrome .sw-doc-delete-confirm:hover:not(:disabled) { filter: brightness(1.08); }

    /* .org format badge (stream_weaver-gnj8) -- unconditional on every org
       entry, not just on a name collision with its .rb sibling; see the
       ERB comment above this class's only use site for why. */
    #sw-reader-files .sw-reader-file-badge {
      display: inline-block; margin-left: 0.4rem; padding: 0.05rem 0.35rem;
      font-size: 0.65rem; font-weight: 600; letter-spacing: 0.02em;
      color: #6b7280; background: #e5e7eb; border-radius: 3px;
    }

    /* Repo filter (stream_weaver-iugu) -- same chip treatment as
       .browse-shortcuts below, since it is the same kind of control (a row
       of small jump targets above the listing) and two different-looking
       chip rows in one 220px rail would read as two unrelated mechanisms.
       Only the .active state is new: unlike Browse's shortcuts, exactly one
       of these is always the current view. */
    #sw-reader-files .repo-filter {
      padding: 0.5rem 1rem; display: flex; gap: 0.4rem; flex-wrap: wrap;
      border-bottom: 1px solid #e5e7eb;
    }
    #sw-reader-files .repo-filter a {
      font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 3px;
      background: #e5e7eb; color: #374151; text-decoration: none;
      max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    #sw-reader-files .repo-filter a:hover { background: #d1d5db; }
    #sw-reader-files .repo-filter a.active {
      background: #dbeafe; color: #1d4ed8; font-weight: 600;
    }

    /* Browse (stream_weaver-rdh). .browse-listing reuses .dir-files li a's
       styling above (same selector chain) for consistent link appearance;
       only the browse-specific chrome (shortcuts, breadcrumbs, up/back
       links) needs its own rules. */
    #sw-reader-files .browse-shortcuts {
      padding: 0.5rem 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;
      border-bottom: 1px solid #e5e7eb;
    }
    #sw-reader-files .browse-shortcuts a {
      font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 3px;
      background: #e5e7eb; color: #374151; text-decoration: none;
    }
    #sw-reader-files .browse-shortcuts a:hover { background: #d1d5db; }
    #sw-reader-files .browse-crumbs {
      padding: 0.4rem 1rem; font-size: 0.72rem; color: #6b7280;
      word-break: break-all; border-bottom: 1px solid #e5e7eb;
    }
    #sw-reader-files .browse-crumbs a { color: #4b5563; text-decoration: none; }
    #sw-reader-files .browse-crumbs a:hover { text-decoration: underline; }
    #sw-reader-files .browse-crumbs .crumb-sep { color: #9ca3af; }
    #sw-reader-files .browse-listing .browse-up,
    #sw-reader-files .browse-listing .browse-dir { font-weight: 500; }
    #sw-reader-files .browse-empty {
      padding: 0.5rem 1rem 0.5rem 1.75rem; font-size: 0.75rem; color: #9ca3af;
      font-style: italic;
    }
    #sw-reader-files .browse-back, #sw-reader-files .browse-link {
      display: block; padding: 0.5rem 1rem; font-size: 0.75rem;
      color: #4b5563; text-decoration: none; border-top: 1px solid #e5e7eb;
    }
    #sw-reader-files .browse-back:hover, #sw-reader-files .browse-link:hover {
      background: #e5e7eb; color: #111827;
    }

    /* History section (collapsed by default) */
    #sw-reader-files .history-section-header {
      border-top: 1px solid #e5e7eb; border-bottom: none;
      cursor: pointer; user-select: none; display: flex; align-items: center; gap: 0.4rem;
    }
    #sw-reader-files .history-section-header:hover { background: #e5e7eb; color: #374151; }
    #sw-reader-files .history-arrow { font-size: 0.6rem; transition: transform 0.15s; display: inline-block; }
    #sw-reader-files .history-section-header.expanded .history-arrow { transform: rotate(90deg); }
    #sw-reader-files .history-content.collapsed { display: none; }
    #sw-reader-files .history-session .dir-header { font-size: 0.7rem; color: #6b7280; padding-left: 1.25rem; }
    #sw-reader-files .history-session .dir-files li a {
      padding-left: 2.25rem; font-family: ui-monospace, monospace; font-size: 0.72rem;
    }

    /* Prev/Next docked in the rail -- not a fixed bottom bar, which would
       collide with the Save-as-doc button at bottom right. flex-wrap
       because Export (and, on a doc with mermaid, a second Export
       (offline) row -- stream_weaver-dnq) sits below Prev/counter/Next,
       which already fill the 220px width -- a fourth same-row item would
       squeeze the counter. */
    #sw-reader-nav {
      flex-shrink: 0; border-top: 1px solid #e5e7eb; background: #f9fafb;
      padding: 0.5rem 0.75rem; display: flex; flex-wrap: wrap; align-items: center;
      justify-content: space-between; gap: 0.4rem;
    }
    #sw-reader-nav .nav-link {
      background: #e5e7eb; color: #374151; border: none; padding: 0.3rem 0.6rem;
      border-radius: 4px; cursor: pointer; font-size: 0.75rem;
      text-decoration: none; display: inline-block;
    }
    #sw-reader-nav .nav-link:hover { background: #d1d5db; color: #111827; }
    #sw-reader-nav .nav-link--disabled { opacity: 0.35; cursor: default; pointer-events: none; }
    #sw-reader-nav .counter { font-size: 0.72rem; color: #6b7280; white-space: nowrap; }
    #sw-reader-nav .nav-export { flex-basis: 100%; text-align: center; }

    /* Mandatory below ~1100px: the sidebar_toc's own desktop breakpoint
       (min-width: 1000px) measures the VIEWPORT, not the doc's content
       region, so a permanently-present 220px rail leaves the doc cramped at
       common laptop widths. Default to collapsed and let the toggle slide it
       back in over the content. */
    @media (max-width: 1100px) {
      html { padding-left: 0; }
      #sw-reader-chrome { left: -220px; }
      html.sw-rail-open #sw-reader-chrome { left: 0; box-shadow: 0 0 30px rgba(0,0,0,0.18); }
    }
  }</style>

  <%# CDN dependencies. Written out here rather than via adapter.cdn_scripts:
      the adapter is in :websocket mode (for component-markup parity with the
      canvas) and would emit a connect script for /canvas/reader/ws, which the
      reader doesn't serve -- 5 failed reconnects in the console. %>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/github.min.css">
  <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/highlight.min.js"></script>

  <%# Mermaid zoom/pan engine — inlined here so it self-inits on DOMContentLoaded %>
  <script><%= @mermaid_zoom_js %></script>
  <%# Kick off mermaid CDN preload immediately (same pattern as bridge server) %>
  <script>if (window.swMermaidPreload) window.swMermaidPreload();</script>
</head>
<body class="<%= body_class %>">

<%# #app-container is a DIRECT body child, exactly as the canvas renders it.
    Every sidebar_toc/theme selector that matters uses the ">" combinator
    against `body[class*="sw-layout-"] > #app-container` -- nesting it inside
    a wrapper leaves all of them dead. data-sw-body-class is read back by the
    htmx:afterSwap handler below, since <body>'s own class attribute is never
    part of the swapped region. %>
<div id="app-container" data-sw-body-class="<%= body_class %>">
  <% if doc %>
    <%= doc.html %>
  <% else %>
    <div style="padding: 3rem; text-align: center; color: #6b7280; font-family: system-ui, sans-serif;">
      Pick a <code>.rb</code> or <code>.org</code> file from the browser on the left.
    </div>
  <% end %>
</div>

<%# hx-boost lives on the chrome, not <body>: that keeps in-document
    .sw-sidebar-toc__link anchors (#section-id jumps) structurally outside the
    boosted subtree. hx-swap="outerHTML" is required -- hx-select keeps the
    matched element itself, so innerHTML would nest a new #app-container
    inside the old one on every click, killing every ">" selector and
    getElementById('app-container') lookup after the first navigation.
    #sw-reader-files is deliberately NOT in this default hx-select-oob --
    stream_weaver-8v1 keeps accordion expand/collapse state alive across
    Prev/Next and sidebar clicks precisely BY never swapping it. Browse
    (stream_weaver-rdh) needs the opposite (the sidebar's own content has to
    change between directories), so its links carry their own, wider
    hx-select-oob (BROWSE_OOB below) that overrides this default -- boosted
    per-element attributes win over the ancestor's, so normal docs/history
    navigation is untouched. %>
<%# x-data for the delete confirm (stream_weaver-uvaj) sits HERE, on the one
    piece of chrome that is never itself swapped -- the delete buttons live
    in #sw-reader-files and the request they fire replaces that whole region,
    so component state kept inside it would be torn out from under its own
    in-flight callback. Descendants inherit the scope, which is all the
    buttons need. %>
<nav id="sw-reader-chrome"
     x-data="swDeleteDoc()" @keydown.escape.window="delOpen = false"
     hx-boost="true" hx-target="#app-container" hx-select="#app-container"
     hx-swap="outerHTML" hx-select-oob="#sw-reader-nav">

  <button id="sw-reader-toggle" type="button" onclick="swToggleRail()"
          title="Toggle file rail" aria-label="Toggle file rail">☰</button>

  <div id="sw-reader-files">
    <% if browse_mode %>
      <%# Every link in this block carries its own hx-select-oob, wider than
          the chrome's default (#sw-reader-nav alone, see the <nav> comment
          above) -- Browse needs the sidebar's own CONTENT to change between
          directories, unlike normal docs/history navigation, which needs it
          to stay untouched so accordion state survives (stream_weaver-8v1).
          A boosted element's own hx-* attributes override its ancestor's. %>
      <h2>Browse</h2>
      <%# First thing in the listing, not last -- previously sat after the
          whole file/dir listing (browse-back below), which meant scrolling
          past a potentially long directory to find the only way out of
          Browse mode. stream_weaver-gnj8. %>
      <a href="/?file=0" class="browse-back" <%= browse_oob %>>← Back to docs</a>
      <div class="browse-shortcuts">
        <% if @repo_docs_root %>
          <a href="/browse?dir=<%= ERB::Util.url_encode(@repo_docs_root) %>" <%= browse_oob %>>This repo</a>
        <% end %>
        <a href="/browse?dir=<%= ERB::Util.url_encode(StreamWeaver::Canvas::DocStore::DEFAULT_ROOT) %>" <%= browse_oob %>>StreamWeaver (global)</a>
      </div>
      <div class="browse-crumbs">
        <a href="/browse?dir=%2F" <%= browse_oob %>>/</a>
        <% @breadcrumbs.each do |label, crumb_path| %>
          <span class="crumb-sep">/</span><a href="/browse?dir=<%= ERB::Util.url_encode(crumb_path) %>" <%= browse_oob %>><%= ERB::Util.h(label) %></a>
        <% end %>
      </div>
      <%# Filenames/dirnames come straight off the filesystem -- '"', '<', '&'
          are all legal there, and unlike the fixed docs sections above,
          Browse can be pointed at literally any directory (~/Downloads
          included, where an attacker controls a dropped file's name). Every
          filesystem-derived string in this block is ERB::Util.h'd; the
          hrefs are already safe via url_encode. %>
      <ul class="dir-files browse-listing">
        <% if @browse_parent %>
          <li><a href="/browse?dir=<%= ERB::Util.url_encode(@browse_parent) %>" class="browse-up" <%= browse_oob %>>.. (up)</a></li>
        <% end %>
        <% @browse_entries[:dirs].each do |name| %>
          <li><a href="/browse?dir=<%= ERB::Util.url_encode(File.join(@browse_dir, name)) %>" class="browse-dir" <%= browse_oob %>>📁 <%= ERB::Util.h(name) %></a></li>
        <% end %>
        <% @browse_entries[:files].each do |name| %>
          <% full = File.join(@browse_dir, name) %>
          <li><a href="/open?path=<%= ERB::Util.url_encode(full) %>" class="<%= full == @current_file ? 'active' : '' %>" title="<%= ERB::Util.h(full) %>" <%= browse_oob %>><%= ERB::Util.h(name) %></a></li>
        <% end %>
        <% if @browse_entries[:dirs].empty? && @browse_entries[:files].empty? %>
          <li class="browse-empty">(empty)</li>
        <% end %>
      </ul>
    <% else %>
      <h2><%= history_groups.any? ? 'Docs' : 'Files' %></h2>
      <%# Repo filter (stream_weaver-iugu). Only rendered once there is more
          than one repo to choose between -- a single-repo rail has nothing to
          filter and the row would be pure noise. Each link carries browse_oob
          for the same reason Browse's links do: the sidebar's own CONTENT has
          to change, and the chrome's default OOB (#sw-reader-nav alone,
          stream_weaver-8v1) deliberately leaves #sw-reader-files untouched. %>
      <% if repo_labels.size > 1 %>
        <div class="repo-filter">
          <% repo_labels.each do |label| %>
            <a href="/?file=<%= @current_index || 0 %>&amp;repo=<%= ERB::Util.url_encode(label) %>"
               class="<%= label == @repo_filter ? 'active' : '' %>" <%= browse_oob %>><%= ERB::Util.h(label) %></a>
          <% end %>
          <a href="/?file=<%= @current_index || 0 %>&amp;repo=all"
             class="<%= @repo_filter.nil? ? 'active' : '' %>" <%= browse_oob %>>All</a>
        </div>
      <% end %>
      <% docs_groups.each do |dir, entries| %>
        <% dir_label = @file_list.label_for(dir) %>
        <% deletable = deletable_dirs.include?(dir) %>
        <div class="dir-section">
          <div class="dir-header expanded" onclick="toggleSection(this)">
            <span class="dir-arrow">▶</span>
            <span title="<%= dir %>"><%= dir_label %></span>
          </div>
          <ul class="dir-files">
            <% entries.each do |filepath, idx| %>
              <li>
                <a href="/?file=<%= idx %><%= repo_qs %>"
                   class="<%= idx == @current_index ? 'active' : '' %>"
                   title="<%= filepath %>">
                  <%# History entries are always .rb (written by canvas-push,
                      see doc_store.rb) so plain File.basename(path, '.rb')
                      is still correct below in the history block -- this
                      docs_groups block is the one FileList.build now also
                      populates with .org, so it needs both extensions
                      stripped, not just one. %>
                  <%= File.basename(filepath).sub(/\.(rb|org)\z/, '') %>
                  <%# Shown unconditionally on every .org entry, not just on
                      a name collision (stream_weaver-gnj8) -- a same-stem
                      .rb/.org pair (demo.rb + demo.org) is otherwise
                      indistinguishable once the extension is stripped
                      above, and a badge that only sometimes appears would
                      be worse than one that's always there: you couldn't
                      trust its absence to mean "no other version exists."
                      .rb gets no badge -- it's the implied default. %>
                  <% if filepath.end_with?('.org') %><span class="sw-reader-file-badge">org</span><% end %>
                </a>
                <%# One row = one file: a .rb/.org pair are two entries with
                    two independent delete buttons, and deleting one never
                    cascades to its sibling. This button opens the confirm
                    dialog and nothing else -- the actual POST only ever fires
                    from the dialog's own Delete button (no JS confirm dialog
                    anywhere on this page; the design doc rules it out). Same
                    to_json-then-h quoting the Save-as-doc widget documents
                    below: a filesystem name can legally contain a quote or an
                    apostrophe, and either escape alone breaks out of the
                    attribute. %>
                <% if deletable %>
                  <button type="button" class="sw-doc-delete"
                          title="Delete <%= ERB::Util.h(File.basename(filepath)) %>"
                          aria-label="Delete <%= ERB::Util.h(File.basename(filepath)) %>"
                          @click.prevent.stop="askDelete(<%= ERB::Util.h(filepath.to_json) %>, <%= ERB::Util.h(File.basename(filepath).to_json) %>)">🗑</button>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if history_groups.any? %>
        <h2 class="history-section-header" onclick="toggleSection(this)">
          <span class="history-arrow">▶</span>
          History (<%= history_groups.size %>)
        </h2>
        <div class="history-content collapsed">
          <% history_groups.each do |dir, entries| %>
            <% session_label = File.basename(dir) %>
            <div class="dir-section history-session">
              <div class="dir-header" onclick="toggleSection(this)">
                <span class="dir-arrow">▶</span>
                <span title="<%= dir %>"><%= session_label %></span>
              </div>
              <ul class="dir-files collapsed">
                <% entries.each do |filepath, idx| %>
                  <li>
                    <a href="/?file=<%= idx %><%= repo_qs %>"
                       class="<%= idx == @current_index ? 'active' : '' %>"
                       title="<%= filepath %>">
                      <%= File.basename(filepath, '.rb') %>
                    </a>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      <% end %>

      <a href="/browse" class="browse-link" <%= browse_oob %>>📁 Browse files…</a>
    <% end %>
  </div>

  <div id="sw-reader-nav">
    <%# @current_index is unset for a file opened via Browse (stream_weaver-rdh)
        -- it isn't part of any FileList, so there's no index to page
        Prev/Next through and no ?file=N to hand /export. Browsed files skip
        this whole block rather than guessing at a meaningless index. %>
    <% if @current_index %>
      <% prev_idx = @current_index - 1 %>
      <% next_idx = @current_index + 1 %>
      <% if prev_idx >= 0 %>
        <a href="/?file=<%= prev_idx %><%= repo_qs %>" class="nav-link" data-nav="prev">◀ Prev</a>
      <% else %>
        <span class="nav-link nav-link--disabled">◀ Prev</span>
      <% end %>
      <span class="counter"><%= @current_index + 1 %> of <%= @file_list.size %></span>
      <% if next_idx < @file_list.size %>
        <a href="/?file=<%= next_idx %><%= repo_qs %>" class="nav-link" data-nav="next">Next ▶</a>
      <% else %>
        <span class="nav-link nav-link--disabled">Next ▶</span>
      <% end %>

      <%# Available for every file, not just history snapshots. hx-boost="false"
          is mandatory: this link is inside the boosted <nav>, and a boosted
          click would swap the downloaded document into #app-container instead
          of handing it to the browser as a file.
          No `download` attribute: Content-Disposition: attachment already
          triggers the save-as on success and leaves this page in place --
          `download` would additionally force a 422/500 error body into
          ~/Downloads as an extensionless file instead of showing the error.
          target="_blank" keeps a failed export's error text out of the way
          of the page you were reading. %>
      <a href="/export?file=<%= @current_index %>" class="nav-link nav-export"
         hx-boost="false" target="_blank"
         title="Download this doc as a standalone HTML file">⬇ Export HTML</a>

      <%# Fetches and inlines mermaid's own library instead of referencing its CDN
          (stream_weaver-dnq), so mermaid diagrams render in a viewer whose CSP
          blocks external scripts entirely -- SharePoint's HTML preview is the
          motivating case. Only shown on a doc that actually has a mermaid
          diagram (@doc.html always contains "sw-mermaid" for one, in either
          the diagram's own CSS class or its lazily-injected CSS block) --
          the flag does nothing on a doc without one, so a second identical
          button there would just be a confusing extra click with no effect. %>
      <% if @doc.html.include?("sw-mermaid") %>
        <a href="/export?file=<%= @current_index %>&amp;offline=1" class="nav-link nav-export"
           hx-boost="false" target="_blank"
           title="Download as standalone HTML with mermaid's library inlined, for viewers that block external scripts (e.g. SharePoint)">⬇ Export HTML (offline)</a>
      <% end %>
    <% elsif @current_file %>
      <span class="counter" title="<%= ERB::Util.h(@current_file) %>">Browsed: <%= ERB::Util.h(File.basename(@current_file)) %></span>
    <% end %>

<% if is_history %>
  <%# Save-as-doc widget — promotes this history snapshot to docs/streamweaver_canvas/.
      Chrome (CSS + Alpine skeleton) shared with the canvas page's own widget via
      SaveDocWidget (stream_weaver-e13); only the endpoint, default-name source,
      the file: index, and copy below are specific to the reader. Rendered inside
      this same is_history conditional (not hoisted up with #sw-reader-chrome-css)
      because spec/canvas/reader_promote_history_spec.rb asserts the sw-save-doc-*
      strings are absent entirely for docs files. %>
  <%
    # to_json gives valid JS-string quoting (handles embedded quotes/apostrophes
    # from a filesystem-derived name correctly); ERB::Util.h then HTML-escapes
    # the result for the surrounding "..." attribute. Either alone is wrong: bare
    # to_json leaks a literal " that closes the attribute early (the exact q4y
    # regression the spec below guards against); the old ERB::Util.h(name) with
    # hand-written '...' quotes HTML-escapes ' to &#39;, which the HTML parser
    # decodes back to a literal ' before Alpine ever sees it, so an apostrophe in
    # the name still breaks out.
  %>
  <%= StreamWeaver::Canvas::SaveDocWidget.render(
    endpoint: '/save-doc',
    button_title: 'Save this history snapshot as a persistent doc',
    dialog_title: 'Save snapshot as doc',
    hint_html: <<~HINT.strip,
      <span x-show="format !== 'org'">Promotes this history entry to <code>docs/streamweaver_canvas/&lt;name&gt;.rb</code> (or <code>~/.streamweaver/canvas/</code> outside a git repo).</span>
      <span x-show="format === 'org'">Promotes this history entry to a human-readable <code>&lt;name&gt;.org</code> sibling file alongside the canonical <code>.rb</code>.</span>
    HINT
    # The reader's default name is derived from the archived snapshot's own
    # filename, not wall-clock "now", so it's computed once server-side and
    # needs no client-side recompute on openDialog() (reset_name_js: '').
    name_init: ERB::Util.h(default_name.to_json),
    # stream_weaver-j3b3: the reader has no live session/source_dir to carry
    # (see the save-doc route's own comment) -- this just computes the same
    # git-root auto-detection DocStore.save already does internally, so the
    # toggle's label/hide-when-nil matches what "This repo" actually resolves
    # to today.
    source_dir: StreamWeaver::Canvas::DocStore.git_root(Dir.pwd),
    extra_alpine_data: "file: #{@current_index},\n    ",
    extra_body_fields: 'file: this.file, ',
    # display:contents keeps the widget (inside #sw-reader-nav, a flex row so
    # the OOB swap refreshes its file: index on every boosted navigation) from
    # becoming a fourth flex item and pushing Next off the right edge -- both
    # its real children are position:fixed, so nothing lands in the flow.
    host_class: 'sw-save-doc-host',
    css_layer: 'sw-reader-chrome',
    dialog_css_extra: "\n      color: #111827; text-align: left;",
    gist: gist_widget_data(default_name)
  ) %>
<% end %>
  </div>

<%# Delete confirm (stream_weaver-uvaj). Outside #sw-reader-files and
    #sw-reader-nav on purpose: both are swapped by the very request this
    dialog triggers. Rendered only when something on screen is actually
    deletable. position:fixed, so its placement in the rail's flex column
    doesn't affect where it appears -- and the rail collapses with `left`
    rather than `transform` precisely so fixed descendants stay
    viewport-fixed (see #sw-reader-chrome's CSS comment). %>
<% if deletable_dirs.any? %>
  <div x-show="delOpen" x-cloak class="sw-doc-delete-modal" @click.self="delOpen = false">
    <div class="sw-doc-delete-dialog" @click.stop>
      <h3>Delete this doc?</h3>
      <p class="hint">
        <%# Deliberately conditional about git: only ONE of the two deletable
            roots is a repo. The global store (~/.streamweaver/canvas) has no
            git safety net at all, and promising one there would be a lie at
            exactly the moment it matters most. %>
        <code x-text="delName"></code> is removed from disk. Nothing is staged or
        committed — inside a repo the deletion simply shows up in <code>git status</code>,
        the same as deleting the file in Finder.
      </p>
      <div x-show="delError" x-text="delError" class="sw-doc-delete-error"></div>
      <div class="sw-doc-delete-actions">
        <button type="button" class="sw-doc-delete-cancel" @click="delOpen = false" :disabled="delBusy">Cancel</button>
        <%# hx-select-oob is here, not on #sw-reader-files: htmx resolves it
            from the element passed as the request's `source`, and this button
            is the one element that can carry the wider Browse-style OOB
            without ALSO becoming an ancestor of the ordinary file links --
            which would make every sidebar click re-render the rail and blow
            away accordion state (stream_weaver-8v1). %>
        <button type="button" class="sw-doc-delete-confirm"
                <%= browse_oob %>
                @click="doDelete()" :disabled="delBusy">
          <span x-show="!delBusy">Delete</span>
          <span x-show="delBusy">Deleting…</span>
        </button>
      </div>
    </div>
  </div>
<% end %>
</nav>

<script>
  // Shared by docs/history-session dir-headers and the outer History (N)
  // header -- both are a header immediately followed by the region it
  // discloses, so one function drives all three. Arrow rotation is pure CSS
  // (.expanded .dir-arrow / .history-arrow), not inline style, so it can't
  // drift out of sync with the collapsed state the way per-glyph inline
  // transforms did.
  function toggleSection(header) {
    header.classList.toggle('expanded');
    header.nextElementSibling.classList.toggle('collapsed');
  }

  // Delete a saved doc (stream_weaver-uvaj). Defined as a global rather than
  // inlined into x-data so the same component can be re-created verbatim
  // every time htmx swaps the rail. This inline script runs during parsing,
  // Alpine's CDN tag is `defer`, so the function always exists by the time
  // Alpine evaluates the attribute.
  function swDeleteDoc() {
    return {
      delOpen: false, delPath: null, delName: null, delBusy: false, delError: null,

      // The row button's only job. Nothing is deleted until the dialog's own
      // Delete button calls doDelete() -- there is deliberately no JS
      // confirm dialog anywhere on this page.
      askDelete(path, name) {
        this.delPath = path;
        this.delName = name;
        this.delError = null;
        this.delOpen = true;
      },

      async doDelete() {
        if (this.delBusy) return;
        this.delBusy = true;
        this.delError = null;
        let landing;
        try {
          const res = await fetch('/delete-doc', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({path: this.delPath, file: swCurrentFileIndex()})
          });
          const data = await res.json();
          if (res.ok && data.ok) {
            landing = data.file;
            this.delOpen = false;
          } else {
            this.delError = data.error || ('HTTP ' + res.status);
          }
        } catch (e) {
          this.delError = e.message;
        }
        this.delBusy = false;
        // Strictly after this component's own state is settled: the refresh
        // swaps #sw-reader-files, and Alpine tears down every component
        // inside it as it goes.
        if (landing !== undefined) swRefreshAfterDelete(landing);
      }
    };
  }

  function swCurrentFileIndex() {
    const n = parseInt(new URLSearchParams(window.location.search).get('file'), 10);
    return Number.isInteger(n) ? n : null;
  }

  // Re-fetches the doc AND both sidebar regions through htmx rather than
  // reloading the page. `source` is the element htmx resolves hx-select-oob
  // from, and the dialog's Delete button carries the same wider OOB the
  // Browse links use -- the chrome's default (#sw-reader-nav alone)
  // deliberately leaves the file rail untouched, which is exactly what has to
  // change here. fileIndex is null when nothing survived: ?file=0 against an
  // empty list renders the no-doc-open placeholder rather than a 404.
  function swRefreshAfterDelete(fileIndex) {
    const repo = new URLSearchParams(window.location.search).get('repo');
    let url = '/?file=' + (fileIndex === null ? 0 : fileIndex);
    if (repo) url += '&repo=' + encodeURIComponent(repo);
    window.history.replaceState(null, '', url);
    htmx.ajax('GET', url, {
      source: document.querySelector('.sw-doc-delete-confirm'),
      target: '#app-container',
      select: '#app-container',
      swap: 'outerHTML'
    });
  }

  // Rail collapse. Below 1100px the rail is collapsed by default and the
  // toggle slides it in (.sw-rail-open); above, it's open by default and the
  // toggle slides it out (.sw-rail-collapsed). Classes go on <html> because
  // the offset rule they drive is `html { padding-left }`.
  function swToggleRail() {
    const root = document.documentElement;
    if (window.matchMedia('(max-width: 1100px)').matches) {
      root.classList.remove('sw-rail-collapsed');
      root.classList.toggle('sw-rail-open');
    } else {
      root.classList.remove('sw-rail-open');
      root.classList.toggle('sw-rail-collapsed');
    }
  }

  // Keyboard arrows trigger Prev/Next anchors so they go through htmx
  // (preserving sidebar state). The anchors handle their own enabled/disabled
  // state via the [data-nav] selector — disabled state is rendered as <span>
  // (no [data-nav]) so the click finds nothing.
  //
  // Suppressed while focus is in a text input/textarea/contenteditable (the
  // Save-as-doc name field lives on this same page) -- otherwise correcting
  // a typo with Left/Right silently navigates the reader out from under the
  // open dialog. Also suppressed with any modifier held, so it doesn't
  // shadow browser/OS shortcuts that happen to use the arrow keys.
  document.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.target.closest('input, textarea, [contenteditable="true"]')) return;
    // A mermaid fullscreen expand (stream_weaver-yjv) is a <dialog> opened
    // via showModal(), which makes the rest of the page inert to *user*
    // interaction -- but inert doesn't stop a programmatic .click() like
    // this handler's, so without this guard, arrow-key nav still silently
    // navigates the reader out from under an open diagram.
    if (document.querySelector('dialog[open]')) return;
    if (e.key === 'ArrowLeft')  document.querySelector('[data-nav="prev"]')?.click();
    if (e.key === 'ArrowRight') document.querySelector('[data-nav="next"]')?.click();
  });

  // Only #app-container and #sw-reader-nav are swapped by default (Browse
  // links, stream_weaver-rdh, additionally swap #sw-reader-files via their
  // own wider BROWSE_OOB), so two things the rest of the page depends on
  // have to be re-derived by hand after each swap:
  //   1. <body>'s theme/layout classes — file N may be :doc themed and N+1 not.
  //   2. the active link in #sw-reader-files, when it wasn't itself swapped
  //      this time (stream_weaver-8v1 -- the whole reason it usually isn't:
  //      an actual re-render would reset any accordion section a user had
  //      opened).
  document.addEventListener('htmx:afterSwap', () => {
    const container = document.getElementById('app-container');
    if (container && container.dataset.swBodyClass) {
      document.body.className = container.dataset.swBodyClass;
    }
    const current = new URLSearchParams(window.location.search).get('file');
    // Browse/Open URLs (and "/", mid-redirect to "/?file=0") carry no
    // ?file= at all -- current is null there. Without this guard,
    // `href.searchParams.get('file') === current` reads as `null === null`
    // for every single Browse link (none of them have a file= param
    // either), so the whole listing lit up .active, and the one
    // non-Browse link on that response ("Back to docs", also file-less)
    // stripped the .active class the OOB swap had just correctly set. Only
    // do this comparison when there's an actual file index to compare.
    if (current === null) return;
    document.querySelectorAll('#sw-reader-files .dir-files a').forEach((a) => {
      const href = new URL(a.getAttribute('href'), window.location.origin);
      a.classList.toggle('active', href.searchParams.get('file') === current);
    });
  });
</script>
</body>
</html>
