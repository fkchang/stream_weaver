#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/browser_smoke — deterministic browser acceptance over the parity slices
#
# bin/smoke drives StreamWeaver over raw HTTP; it can prove the server emits
# the right bytes but not that a real browser (Alpine reactivity, htmx swap
# extensions, JS event ordering) does the right thing with them. This script
# closes that gap: it boots the parity slice apps for real and drives them
# with playwright-cli (a standalone CLI, NOT the playwright MCP tool -- see
# /opt/homebrew/bin/playwright-cli), asserting on the live accessibility
# snapshot, DOM state, and console output.
#
#   bin/browser_smoke
#
# Exits 0 only if every non-pending check passes. Checks marked "pending"
# are printed but do not affect the exit code -- a defect this script itself
# discovers gets a bd bug filed and the assertion marked pending, not
# silently dropped (see the `pending` helper below).
#
# Requires playwright-cli on PATH (`brew install` or see its own docs) and a
# StreamWeaver checkout with bundle installed.

require 'open3'
require 'json'
require 'fileutils'
require 'tmpdir'
require 'socket'

REPO_ROOT = File.expand_path('..', __dir__)
PLAYWRIGHT = 'playwright-cli'
SESSION = 'sw_browser_smoke'

CHECK = "✓"
CROSS = "✗"
PENDING = "○"

$results = []
$pids = []

# ---------------------------------------------------------------------------
# App boot / port discovery
# ---------------------------------------------------------------------------

def portfile_path(app_title)
  sanitized = app_title.downcase.gsub(/[^a-z0-9_-]/, "_")
  File.expand_path("~/.streamweaver/apps/#{sanitized}.port")
end

def boot_app(script_path, app_title)
  path = portfile_path(app_title)
  FileUtils.rm_f(path) # stale portfile from a previous run would report the wrong (dead) port

  log = File.join(Dir.mktmpdir('sw-browser-smoke-'), 'boot.log')
  # SW_NO_OPEN suppresses auto-opening a browser tab per boot (scripted runs only)
  pid = Process.spawn({ 'SW_NO_OPEN' => '1' }, 'bundle', 'exec', 'ruby', script_path, chdir: REPO_ROOT, pgroup: true, out: log, err: log)
  $pids << pid

  deadline = Time.now + 15
  until File.exist?(path)
    if Time.now > deadline
      raise "#{app_title} never wrote a portfile at #{path} -- boot log:\n#{File.read(log)}"
    end
    sleep 0.1
  end

  url = File.read(path)[/^url=(.+)$/, 1] or raise "malformed portfile at #{path}"
  url
end

def kill_all_tracked
  $pids.each do |pid|
    Process.kill('TERM', -pid)
  rescue Errno::ESRCH, Errno::EPERM
    next
  end
  sleep 0.3
  $pids.each do |pid|
    Process.kill('KILL', -pid)
  rescue Errno::ESRCH, Errno::EPERM
    next
  end
  $pids.each do |pid|
    Process.wait(pid)
  rescue Errno::ECHILD
    next
  end
  $pids.clear
end

at_exit do
  kill_all_tracked
  system(PLAYWRIGHT, '-s=' + SESSION, 'close', out: File::NULL, err: File::NULL)
end

# ---------------------------------------------------------------------------
# playwright-cli driver
# ---------------------------------------------------------------------------

def pw(*args)
  out, err, status = Open3.capture3(PLAYWRIGHT, '-s=' + SESSION, *args)
  raise "playwright-cli #{args.join(' ')} failed (exit #{status.exitstatus}):\n#{out}\n#{err}" unless status.success?
  out
end

# `eval` prints the result between "### Result" and the next "### " header,
# JSON-encoded for strings. Falls back to the raw text for anything that
# doesn't parse (e.g. `undefined`).
def pw_eval(js)
  out = pw('eval', "() => (#{js})")
  body = out[/### Result\n(.*?)\n### /m, 1] || out[/### Result\n(.*)\z/m, 1]
  body = body.to_s.strip
  begin
    JSON.parse(body)
  rescue JSON::ParserError
    body
  end
end

def pw_snapshot_text
  out = pw('snapshot')
  rel = out[/\[Snapshot\]\((.+?\.yml)\)/, 1] or raise "no snapshot path in:\n#{out}"
  File.read(File.join(REPO_ROOT, rel))
end

def pw_click(ref)
  out = pw('click', ref)
  rel = out[/\[Snapshot\]\((.+?\.yml)\)/, 1] or raise "no snapshot path in:\n#{out}"
  File.read(File.join(REPO_ROOT, rel))
end

def pw_console_log_path
  out = pw('console')
  rel = out[/\[Console\]\((.+?\.log)\)/, 1] or raise "no console log path in:\n#{out}"
  File.join(REPO_ROOT, rel)
end

# Slice of a snapshot from a "- row \"...<needle>...\"" line up to (but not
# including) the next sibling row at the same indent -- lets a query target
# "the Edit button in Nora Albrecht's row" instead of the first Edit on the
# page.
def row_block(snapshot_text, needle)
  lines = snapshot_text.lines
  start_idx = lines.index { |l| l =~ /- row "/ && l.include?(needle) }
  return nil unless start_idx

  indent = lines[start_idx][/^(\s*)/, 1].length
  rest = lines[(start_idx + 1)..] || []
  end_offset = rest.index { |l| l =~ /^\s*- row "/ && l[/^(\s*)/, 1].length <= indent }
  end_idx = end_offset ? start_idx + 1 + end_offset : lines.length
  lines[start_idx...end_idx].join
end

def ref_for(text, role, label)
  return nil unless text
  m = text.match(/#{role} "#{Regexp.escape(label)}"[^\[\n]*\[ref=(e\d+)\]/)
  m && m[1]
end

# Like ref_for, but for an unlabeled textbox (no <label>, no placeholder) --
# the accessibility snapshot renders those as `- textbox [ref=eN]: <current value>`
# instead of `textbox "label" [ref=eN]`, so match on the current value instead.
# (Unused now that quick-edit's fields render a visible <label> -- FAC-9u2 --
# but kept for any future unlabeled-field case.)
def ref_for_textbox_value(text, value)
  return nil unless text
  m = text.match(/textbox \[ref=(e\d+)\]: #{Regexp.escape(value)}/)
  m && m[1]
end

# ---------------------------------------------------------------------------
# Check runner
# ---------------------------------------------------------------------------

def check(description)
  ok, detail = yield
  $results << [:ok, description] if ok
  if ok
    puts "#{CHECK} #{description}"
  else
    $results << [:fail, description]
    puts "#{CROSS} #{description}#{detail ? " -- #{detail}" : ''}"
  end
rescue StandardError => e
  $results << [:fail, description]
  puts "#{CROSS} #{description} -- raised #{e.class}: #{e.message}"
end

# A known, already-diagnosed defect blocks this assertion (see `reason`).
# Recorded separately from real failures so the script can still exit 0 --
# per bin/browser_smoke's own contract, a defect this script *discovers*
# gets a bd bug filed and the assertion marked pending, not silently
# dropped and not treated as this script's own failure.
def pending(description, reason)
  $results << [:pending, description]
  puts "#{PENDING} #{description} -- PENDING: #{reason}"
end

def section(title)
  puts
  puts "-- #{title} --"
end

# ===========================================================================
# Rivet People (parity slice)
# ===========================================================================

section "Rivet People (parity slice)"

rivet_url = boot_app(File.join(REPO_ROOT, 'examples', 'parity', 'rivet_people_slice.rb'), 'Rivet People (parity slice)')

pw('open')
pw('goto', rivet_url)

snap = pw_snapshot_text

check("initial load: 30 rows, no nested rows") do
  row_count = snap.scan(/- row "/).size
  # The header row plus 30 data rows == 31 total "- row" matches; a nesting
  # regression (a <tr> rendered inside another <tr>) would double-count the
  # affected row's cells but not add a second "- row" line, so this alone
  # doesn't fully rule out nesting -- pair it with the DOM check below.
  ok = row_count == 31
  [ok, ok ? nil : "expected 31 \"- row\" entries (1 header + 30 data), got #{row_count}"]
end

nora_block = row_block(snap, "Nora Albrecht")
touch_ref = ref_for(nora_block, "button", "Touch")

after_touch = nil
check("Touch: row updates (Last column moves to \"today\") and no <tr> nests inside another <tr>") do
  raise "no Touch button found in Nora Albrecht's row" unless touch_ref

  after_touch = pw_click(touch_ref)
  nested = pw_eval("Array.from(document.querySelectorAll('tr')).some(function(tr){ return tr.querySelector('tr') !== null; })")
  after_block = row_block(after_touch, "Nora Albrecht")
  ok = after_block && after_block.include?("today") && nested == false
  [ok, ok ? nil : "row block after touch: #{after_block.inspect}, nested tr check: #{nested.inspect}"]
end

# --- stream_weaver-e4p: the "Edit" button delivers the quick-edit modal via
# `updates: :quick_edit_modal` (not row-local, so it falls back to the
# full-OOB-div path) -- this is the exact shape that used to be silently
# skipped by htmx core's OOB scanning (hx-swap-oob="morph:innerHTML" never
# dispatches through swap-style extensions). Now that OOB elements use plain
# native swap styles (hx-swap-oob="innerHTML"), the modal actually appears.
# Uses the post-Touch snapshot -- Nora Albrecht's row refs shifted after
# that click's DOM update.
edit_ref = ref_for(row_block(after_touch, "Nora Albrecht"), "button", "Edit")

edit_snap = nil
check("Edit: modal fields present in live DOM (x-model + name)") do
  raise "no Edit button found in Nora Albrecht's row" unless edit_ref

  edit_snap = pw_click(edit_ref)
  modal_html = pw_eval("document.getElementById('sw-frag-quick-edit-modal').innerHTML")
  ok = modal_html.is_a?(String) && modal_html.include?('x-model="edit_name"') && modal_html.include?('value="Nora Albrecht"')
  [ok, ok ? nil : "modal innerHTML: #{modal_html.inspect}"]
end

after_save = nil
check("fill name + Save: row shows new name, flash appears, no console errors") do
  # "Name" is the field's <label> text (FAC-9u2: quick-edit's fields are now
  # labeled), so the accessible name comes from the label, not the value.
  name_ref = ref_for(edit_snap, "textbox", "Name")
  save_ref = ref_for(edit_snap, "button", "Save")
  raise "no name textbox found in the quick-edit modal" unless name_ref
  raise "no Save button found in the quick-edit modal" unless save_ref

  pw('fill', name_ref, "Nora Updated")
  after_save = pw_click(save_ref)
  console_log = File.read(pw_console_log_path)
  ok = after_save.include?("Nora Updated") && after_save.include?("Saved Nora Updated.") &&
       console_log.include?("Errors: 0")
  [ok, ok ? nil : "after-save snapshot: #{after_save[0, 300].inspect}, console: #{console_log.inspect}"]
end

check("Edit again: modal reopens") do
  reopen_edit_ref = ref_for(row_block(after_save, "Nora Updated"), "button", "Edit")
  raise "no Edit button found in the renamed row" unless reopen_edit_ref

  reopened = pw_click(reopen_edit_ref)
  modal_html = pw_eval("document.getElementById('sw-frag-quick-edit-modal').innerHTML")
  ok = reopened.include?('heading "Quick edit"') && modal_html.is_a?(String) && modal_html.include?('value="Nora Updated"')

  # Close the modal again so later checks (search) aren't blocked by its
  # full-viewport backdrop intercepting clicks.
  cancel_ref = ref_for(reopened, "button", "Cancel")
  pw_click(cancel_ref) if cancel_ref

  [ok, ok ? nil : "reopen snapshot: #{reopened[0, 200].inspect}, modal innerHTML: #{modal_html.inspect}"]
end

check("search: typing filters the table (live keyup, primary-target swap -- not OOB)") do
  # A fresh snapshot, not `snap` -- refs from the pre-Edit/Save snapshot are
  # stale by now (accessibility ref ids are only valid for the snapshot they
  # were captured in; the intervening clicks reshaped the page).
  # "Search" is the field's <label> text (FAC-9u2), so the accessible name
  # comes from the label now, not the placeholder.
  query_ref = ref_for(pw_snapshot_text, "textbox", "Search")
  raise "no search textbox found" unless query_ref

  pw('click', query_ref)
  pw('press', 'M')
  pw('press', 'i')
  pw('press', 'l')
  pw('press', 'o')
  sleep 0.5 # debounce: 250ms

  row_count = pw_eval("document.querySelectorAll('#sw-frag-people table tbody tr').length")
  ok = row_count.is_a?(Integer) && row_count.positive? && row_count < 30
  [ok, ok ? nil : "expected a partial row count after searching \"Milo\", got #{row_count.inspect}"]
end

# ===========================================================================
# Tyrion War Room (parity slice)
# ===========================================================================

section "Tyrion War Room (parity slice)"

tyrion_url = boot_app(File.join(REPO_ROOT, 'examples', 'parity', 'tyrion_warroom_slice.rb'), 'Tyrion War Room (parity slice)')

pw('goto', tyrion_url)
tyrion_snap = pw_snapshot_text

check("View: detail pane contains the story title (primary: :detail -- not OOB, so unaffected by stream_weaver-e4p)") do
  idx = tyrion_snap.index('forge-the-beacon-relay')
  raise "fixture story \"forge-the-beacon-relay\" not found on the board" unless idx

  view_ref = tyrion_snap[idx..].match(/button "View"[^\[\n]*\[ref=(e\d+)\]/)&.captures&.first
  raise "no View button found near forge-the-beacon-relay" unless view_ref

  after = pw_click(view_ref)
  ok = after.include?('heading "forge-the-beacon-relay"')
  [ok, ok ? nil : "detail pane snapshot did not contain the story heading:\n#{after}"]
end

# ===========================================================================
# Summary
# ===========================================================================

puts
passed = $results.count { |status, _| status == :ok }
pendings = $results.count { |status, _| status == :pending }
failed = $results.count { |status, _| status == :fail }
total = $results.size

puts "#{passed}/#{total} passed, #{pendings} pending (bd bug filed), #{failed} failed"

exit(failed.zero? ? 0 : 1)
