#!/usr/bin/env ruby
# frozen_string_literal: true

# Vendors the browser-side JS/CSS that Opal builds serve locally.
#
# Why local copies at all: an `opal-build` bundle is meant to run with no
# network -- opened from file://, served from a static host, or loaded inside a
# browser extension, where remote script is forbidden outright. CDN <script>
# tags cannot satisfy that.
#
# Two destinations, because of size:
#
#   lib/stream_weaver/opal/stubs/   committed. Small enough to ship in the gem,
#                                   alongside marked.umd.js and morphdom.
#   vendor/js/                      gitignored. Mermaid is ~3.5MB, over the
#                                   500KB ceiling bin/check_git_hygiene
#                                   enforces, so it is fetched on demand and
#                                   OpalBuilder falls back to the CDN when it
#                                   is absent.
#
# Usage: bin/vendor_browser_assets   (requires npm on PATH)

require "fileutils"
require "tmpdir"

ROOT   = File.expand_path("..", __dir__)
STUBS  = File.join(ROOT, "lib", "stream_weaver", "opal", "stubs")
VENDOR = File.join(ROOT, "vendor", "js")

MERMAID_VERSION = "11"
PRISM_VERSION   = "1.29.0"
DIFF_VERSION    = "5.2.0"

# Languages bundled into prism.min.js. Prism's own autoloader plugin fetches
# grammars from a CDN at runtime, which is exactly what we cannot do, so the
# set has to be fixed at build time. Keep it to what documentation actually
# contains -- every addition is bytes in every build.
PRISM_LANGUAGES = %w[
  markup css clike javascript
  ruby python bash json yaml sql
  go rust typescript jsx tsx
  diff markdown toml ini
].freeze

def run(cmd, dir:)
  puts "  $ #{cmd}"
  system(cmd, chdir: dir, out: File::NULL) or abort("failed: #{cmd}")
end

abort "npm not found on PATH" if `which npm`.strip.empty?

FileUtils.mkdir_p(STUBS)
FileUtils.mkdir_p(VENDOR)

Dir.mktmpdir do |tmp|
  puts "Installing packages..."
  run("npm install --no-audit --no-fund --silent " \
      "mermaid@#{MERMAID_VERSION} prismjs@#{PRISM_VERSION} diff@#{DIFF_VERSION}", dir: tmp)

  nm = File.join(tmp, "node_modules")

  # --- Prism: core + fixed grammars, concatenated ---------------------------
  prism_root = File.join(nm, "prismjs")
  parts = [File.read(File.join(prism_root, "prism.js"))]
  PRISM_LANGUAGES.each do |lang|
    path = File.join(prism_root, "components", "prism-#{lang}.min.js")
    unless File.exist?(path)
      warn "  ! no grammar for #{lang}, skipping"
      next
    end
    parts << File.read(path)
  end
  banner = "/* Prism #{PRISM_VERSION} -- core + #{PRISM_LANGUAGES.size} grammars. " \
           "Generated by bin/vendor_browser_assets; do not edit. */\n"
  File.write(File.join(STUBS, "prism.min.js"), banner + parts.join("\n"))

  FileUtils.cp(File.join(prism_root, "themes", "prism-tomorrow.min.css"),
               File.join(STUBS, "prism-tomorrow.min.css"))

  # --- jsdiff: replaces shelling out to diff(1) in the browser --------------
  FileUtils.cp(File.join(nm, "diff", "dist", "diff.min.js"),
               File.join(STUBS, "diff.min.js"))

  # --- Mermaid: too large to commit, so it lands in the gitignored dir ------
  # dist/mermaid.min.js assigns globalThis.mermaid, so it loads as a classic
  # script -- no ESM or import map needed.
  FileUtils.cp(File.join(nm, "mermaid", "dist", "mermaid.min.js"),
               File.join(VENDOR, "mermaid.min.js"))
end

puts "\nVendored:"
[
  [STUBS,  %w[prism.min.js prism-tomorrow.min.css diff.min.js]],
  [VENDOR, %w[mermaid.min.js]]
].each do |dir, files|
  files.each do |f|
    path = File.join(dir, f)
    next unless File.exist?(path)
    puts format("  %-58s %6d KB", path.sub("#{ROOT}/", ""), File.size(path) / 1024)
  end
end
